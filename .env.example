# Docker deployment settings (copy this file to .env)
# ARTEX_TAG is the tag of the image ghcr.io/jiwoochris/artex-global that docker-compose pulls.
# latest points to the most recent release; to pin a specific release, write a v* tag.
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (enter either one or both. You may also leave them empty and set them later in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# First-run protection (prevents remote takeover of the admin account)
# - The web/API ports are published only on the host's 127.0.0.1 by default. If you need to connect
#   directly from another device, change it to ARTEX_BIND=0.0.0.0, but finish the initial setup first.
# - On first start a random setup token is printed in the log (docker compose logs artex),
#   and you must enter that value on the /setup screen to create the admin password.
#   If you set ARTEX_SETUP_TOKEN, that value becomes the token and is not printed in the log.
# - If you set ARTEX_ADMIN_PASSWORD, it initializes directly with that value without /setup (at least 8 characters).
ARTEX_BIND=127.0.0.1
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=
# Allowed browser cross-origin (CORS) list (comma-separated). The embedded UI is same-origin, so leave it empty.
ARTEX_CORS_ORIGINS=

# Default server-side output language (en, ko, zh, es, ja, th). If empty, it is English.
# - It becomes the default for agent reports, summaries, chat replies and server error messages; if you choose
#   "Display language" in the settings screen, that value takes precedence.
# - The server console log follows only this value (independent of the settings screen choice).
# - The language of the web UI text is chosen per browser in the settings screen (English by default).
ARTEX_LANG=
