# backend
/data/
*.db
*.db-wal
*.db-shm
config.json
scheduler_state.json
__pycache__/
*.pyc
*.pyo

# frontend
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
web/next-env.d.ts
*.local

# development tools
.playwright-mcp/
.playwright-cli/
.idea/
.vscode/
*.swp
*.swo

# os
.DS_Store
Thumbs.db

# claude code local state
.claude/

# Single-binary output with the embedded frontend
/artex
# Intermediate files left next to the executable by the one-click update (staging / backup / failed version / upgrade marker)
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# JWT signing key (generated at runtime, stored in the project root, never commit)
/jwt.key

# Local environment generated by Docker deployment (contains passwords/keys, do not commit)
.env

# Event logs produced by scheduler runs/simulations (test artifacts, do not commit)
*-events.csv

# Bench benchmark-related (local artifacts, do not commit)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2
# --- artex-global local operations: do not commit (owner's instruction: keep test/scan results private) ---
work/
test-results/
scan-output/
evidence-local/
# Runtime data created when the demo app is started locally (the recording proxy's traffic index DB,
# the mitmproxy CA private key, etc.), so it is not committed to the public repository (BRIEF boundary #2).
/demo-data/
*.local.env
# D2 model-comparison live test: it lives inside package agent, so it cannot be placed outside work/,
# and it is a local-only artifact that consumes OPENROUTER_API_KEY and the network, so it is not
# committed to the public repository (BRIEF boundary #2). Only the exact path is blocked so upstream-tracked tests are untouched.
agent/d2_models_live_test.go

# API keys and secrets: never commit, wherever they are kept
*.env
secrets.env

# --- Local artifacts of Windows source builds: do not commit ---
# The single Windows binary produced by go build -o artex.exe (counterpart of the Unix /artex)
/artex.exe
# Secrets used in local configuration (e.g. the PostgreSQL password). Never commit.
/.secrets/
# Native binding cache created when SWC_NATIVE_BINDING_CACHE is redirected under the project
/.swc-cache/
# Runtime logs redirected when artex.exe is started in the foreground
/artex.out.log
/artex.err.log
